" Code bellow generated by Gemini and edited by me

let s:configDir = expand('~/.config/vim')

if !isdirectory(s:configDir) || empty(readdir(s:configDir))
    echohl WarningMsg
    echomsg '[vimrc] No files were found in ~/.vim/config. Config loading skipped.'
    echohl None
    finish
endif

" Files that MUST load first
let s:priority = ['vim-dirs.vim', 'plugins.vim']

for file in s:priority
    execute 'source ' . fnameescape(s:configDir . '/' . file)
endfor

" Source everything else, skipping what we already loaded
" for file in glob(s:configDir . '/*.vim', 0, 1)
for file in globpath(s:configDir, '**/*.vim', 0, 1)
    if index(s:priority, fnamemodify(file, ':t')) == -1
        execute 'source ' . fnameescape(file)
    endif
endfor
