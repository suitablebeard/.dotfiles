root = true

[*]
charset = utf-8
end_of_line = LF
indent_style = space
indent_size = 4
max_line_length = 75
trim_trailing_whitespace = true
insert_final_newline = true

[*.lua]
quote_type = single

[Makefile]
indent_style = tab

[*.sh]
shell_variant = bash
simplify = true
binary_next_line = true
switch_case_indent = true
space_redirects = true
function_next_line = false

[[bash]]
shell_variant = bash
simplify = true
binary_next_line = true
switch_case_indent = true
space_redirects = true
function_next_line = false

