export VISUAL=vim
export EDITOR=vim
export GIT_EDITOR=vim

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias cdcode='cd ~/Documents/myFiles/Programming'

alias ls='ls --color=auto'
alias ll='ls --color=auto -la'
alias cls='clear'
alias grep='grep --color=auto'

alias lua='lua54'
